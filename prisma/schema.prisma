// Modelo de dados da Booking API.
//
// Regras que o próprio banco garante (ver migration "init", que complementa este arquivo
// com constraints que o Prisma não consegue expressar):
//  - fim da reserva > início;
//  - um recurso não pode ter duas reservas CONFIRMED sobrepostas (EXCLUDE USING gist);
//  - um usuário não pode estar em duas reservas CONFIRMED sobrepostas.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  bookings      Booking[]
  refreshTokens RefreshToken[]
}

// Refresh tokens são opacos, guardados só como hash (sha256) e rotacionados a cada uso.
// `familyId` agrupa a cadeia de rotações: reaproveitar um token já usado revoga a família toda.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Resource {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  capacity    Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  bookings Booking[]
}

model Booking {
  id          String        @id @default(uuid(7)) @db.Uuid
  resourceId  String        @db.Uuid
  userId      String        @db.Uuid
  startsAt    DateTime      @db.Timestamptz(3)
  endsAt      DateTime      @db.Timestamptz(3)
  status      BookingStatus @default(CONFIRMED)
  notes       String?
  cancelledAt DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  resource Resource @relation(fields: [resourceId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([resourceId, startsAt])
  @@index([userId, startsAt])
}
