# Copie para .env e ajuste. NUNCA versione o .env.
# Só estas duas são obrigatórias; as demais têm valor padrão (ver src/config/env.ts).

DATABASE_URL=postgresql://booking:booking@localhost:5432/booking_dev
# Gere um segredo forte:  openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# --- opcionais (valores padrão entre parênteses) ---
# PORT=3000
# NODE_ENV=development
# LOG_LEVEL=info                  # fatal|error|warn|info|debug|trace|silent
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TTL_DAYS=7
# BCRYPT_COST=12
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100              # requisições por IP por janela
# AUTH_THROTTLE_LIMIT=10          # login/cadastro/refresh por IP por janela
# CANCELLATION_MIN_HOURS=2        # antecedência mínima para o usuário cancelar
# CORS_ORIGINS=https://app.exemplo.com,https://admin.exemplo.com
# TRUST_PROXY=false               # true atrás de proxy reverso (Render, Nginx...)
# SWAGGER_ENABLED=true            # false para esconder /docs em produção

# --- só para o seed (npm run db:seed) ---
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=uma-senha-forte
# SEED_DEMO=true                  # cria recursos de exemplo
